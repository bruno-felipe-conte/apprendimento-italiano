{
  "name": "apprendimento-italiano",
  "version": "1.0.0",
  "description": "Apprendi l'italiano con autenticità - Flashcard, Quiz e Vocabolario",
  "main": "sw.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run tests/security.test.js",
    "lint": "eslint js/",
    "lint:fix": "eslint js/ --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"js/**/*.js\" \"css/**/*.css\"",
    "format:check": "prettier --check \"js/**/*.js\" \"css/**/*.css\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bruno-felipe-conte/apprendimento-italiano.git"
  },
  "keywords": [
    "italian",
    "pwa",
    "fsrs",
    "flashcards",
    "language-learning"
  ],
  "author": "Bruno Felipe Conte",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.20.1",
    "globals": "^17.13.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
