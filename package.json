{
  "name": "apprendimento-italiano",
  "version": "1.0.0",
  "description": "Apprendi l'italiano con autenticità - Flashcard, Quiz e Vocabolario",
  "main": "sw.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run tests/security.test.js",
    "test:a11y": "playwright test tests/a11y --reporter=list",
    "lint": "eslint js/ tests/",
    "lint:fix": "eslint js/ tests/ --fix",
    "typecheck": "tsc --noEmit",
    "content:validate": "tsx scripts/validate_content.ts",
    "content:ingest": "tsx scripts/ingest_content.ts",
    "fsrs:validate": "node scripts/validate-fsrs.js",
    "format": "prettier --write \"js/**/*.{js,ts}\" \"css/**/*.css\" \"types/**/*.ts\"",
    "format:check": "prettier --check \"js/**/*.{js,ts}\" \"css/**/*.css\" \"types/**/*.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bruno-felipe-conte/apprendimento-italiano.git"
  },
  "keywords": [
    "italian",
    "pwa",
    "fsrs",
    "flashcards",
    "language-learning"
  ],
  "author": "Bruno Felipe Conte",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@rolldown/binding-linux-x64-gnu": "^1.2.15",
    "@types/dom-speech-recognition": "^0.0.12",
    "eslint": "^9.20.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.5.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
